# Copy to .env.local and fill in. Never commit .env.local (D56).
# Browser-visible (Vite inlines VITE_* into the front-end bundle): URL and publishable/anon key only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
# Server-only (TanStack server functions):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>
OPENALEX_API_KEY=<from arms-length-spike/.openalex_key>
RESEARCH_PASSCODE=<choose one>
# Migrations only (drizzle-kit): Postgres connection string from Supabase > Connect
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
